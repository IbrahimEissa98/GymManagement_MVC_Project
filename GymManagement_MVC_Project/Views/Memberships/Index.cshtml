@model IReadOnlyList<MembershipIndexViewModel>

@{
	ViewData["Title"] = "Active Memberships";
}

<div class="container pt-5">
	<main role="main" class="pb-3 pt-5">
		<partial name="_TempDataAlertMessage" />
		<!-- Header -->
		<header class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
			<div class="d-flex align-items-center gap-3">
				<div class="page-icon">
					<i class="bi bi-person-lines-fill"></i>
				</div>
				<div>
					<h2 class="text-primary-color mb-1 fw-bold">Active Memberships</h2>
					<p class="text-muted mb-0">Members that have active plans</p>
				</div>
			</div>
			<a asp-controller="Memberships" asp-action="Create" class="btn get-started btn-sm">
				<i class="bi bi-plus-lg me-1"></i>New Membership
			</a>
		</header>

		<!-- Memberships -->
		<div class="card plan-detail-card border-0 overflow-visible">
			<div class="card-header py-2 d-flex justify-content-between align-items-center">

				<h5 class="mb-0 text-white">
					<i class="bi bi-person-workspace me-2"></i>
					Memberships
				</h5>

				<span class="badge bg-light text-dark">
					@Model.Count() Active Membership(s)
				</span>

			</div>

			@if (Model.Any())
			{
				<div class="table-responsive" style="overflow: visible;">
					<table class="table align-middle mb-0">
						<thead>
							<tr>
								<th>
									<i class="bi bi-person-fill text-primary-color me-1"></i>
									<span>Member</span>
								</th>
								<th>
									<i class="bi bi-award text-primary-color me-1"></i>
									<span>Plan</span>
								</th>
								<th>
									<i class="bi bi-calendar-check text-primary-color me-1"></i>
									<span>Start Date</span>
								</th>
								<th>
									<i class="bi bi-calendar-x text-primary-color me-1"></i>
									<span>End Date</span>
								</th>
								<th class="text-center">
									<span>Action</span>
								</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr class="align-middle">
									<td><span>@item.MemberName</span></td>
									<td><span>@item.PlanName</span></td>
									<td><span>@item.StartDate.ToString("MMM dd, yyyy")</span></td>
									<td><span>@item.EndDate.ToString("MMM dd, yyyy")</span></td>
									<td class="text-center px-4">
										<!-- Button trigger modal -->
										<button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#exampleModal-@item.Id">
											Cancel
										</button>

										<!-- Delete Membership Modal -->
										<div class="modal fade" id="exampleModal-@item.Id" tabindex="-1"
											 aria-labelledby="exampleModalLabel" aria-hidden="true">

											<div class="modal-dialog modal-dialog-centered">
												<div class="modal-content border-0 shadow-lg">

													<div class="modal-header">
														<h5 class="modal-title text-primary-color fw-semibold" id="exampleModalLabel">
															<i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
															Cancel Membership
														</h5>

														<button type="button"
																class="btn-close"
																data-bs-dismiss="modal"
																aria-label="Close">
														</button>
													</div>

													<div class="modal-body text-center p-4">

														<i class="bi bi-person-x text-danger display-4 mb-3"></i>

														<h5 class="mb-3">
															Are you sure you want to cancel this membership?
														</h5>

														<p class="text-muted mb-3">
															This membership will be marked as inactive and the member
															will no longer have access to the associated plan.
														</p>

														<div class="alert alert-warning text-start mb-0">
															<i class="bi bi-info-circle-fill me-2"></i>
															<strong>Note:</strong>
															The membership will not be permanently deleted. It can be
															restored later if needed.
														</div>

													</div>

													<div class="modal-footer border-0 px-4 pb-4">
														<button type="button"
																class="btn btn-outline"
																data-bs-dismiss="modal">
															<i class="bi bi-x-lg me-1"></i>
															Cancel
														</button>

														<form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="m-0">
															<button type="submit"
																	class="btn btn-fill bg-danger border-danger">
																<i class="bi bi-person-x me-1"></i>
																Cancel Membership
															</button>
														</form>
													</div>

												</div>
											</div>
										</div>
									</td>
								</tr>
							}

						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="text-center py-5">
					<i class="bi bi-card-checklist display-1 text-muted"></i>
					<h4 class="mt-3 text-muted">No Active Memberships Available</h4>
					<p class="text-muted mb-0">Create a membership to get started.</p>
				</div>
			}

		</div>

	</main>
</div>

@section Scripts {
	<partial name="_AlertDismissScript" />
}