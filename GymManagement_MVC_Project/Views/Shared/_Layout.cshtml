@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string ActiveTap(string name) =>
        string.Equals(controllerName, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script>
        (function () {
        var t = localStorage.getItem('gym-theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script> 
    <style>
        html, body {
        background-color: #f8f9fc;
        color-scheme: light;
        }

        html[data-bs-theme="dark"], html[data-bs-theme="dark"] body {
        background-color: #0f1117;
        color-scheme: dark;
        }
    </style>

    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <title>Power fitness | @ViewData["Title"]</title>
	<link rel="icon" href="~/images/favicon.svg" type="image/x-icon" asp-append-version="true">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/GymManagementProject.styles.css" asp-append-version="true" /> *@

    @RenderSection("Styles", false)

</head>
<body>
    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg site-navbar fixed-top py-2">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <img src="~/images/logo.jpg" alt="Power Fitness logo" />
                </a>

                <div class="d-flex align-items-center gap-2 order-lg-last">
                    <button type="button" class="theme-toggle" id="themeToggle" aria-label="Switch to dark mode" title="Dark mode">
                        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                    </button>
                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @ActiveTap("Home")" aria-current="page" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActiveTap("Members")" asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActiveTap("Trainers")" asp-controller="Trainers" asp-action="Index">Trainers</a>
                        </li>
                        <li class="nav-item">
							<a class="nav-link @ActiveTap("Sessions")" href="#">Sessions</a>
                        </li>
                        <li class="nav-item">
							<a class="nav-link @ActiveTap("Plans")" asp-controller="Plans" asp-action="Index">Plans</a>
                        </li>
                        <li class="nav-item">
							<a class="nav-link @ActiveTap("Memberships")" href="#">Memberships</a>
                        </li>
                        <li class="nav-item">
							<a class="nav-link @ActiveTap("SessionsSchedule")" href="#">Sessions Schedule</a>
                        </li>
                        <li class="nav-item">
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link btn-logout">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GymManagementProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
