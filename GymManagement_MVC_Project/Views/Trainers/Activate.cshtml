@model TrainerDeleteViewModel

@{
    ViewData["Title"] = "Activate Trainer";
}

<div class="container pt-5">

    <nav class="breadcrumb-nav mb-3 pt-5" aria-label="Breadcrumb">
        <a asp-controller="Trainers" asp-action="Index">
            <i class="bi bi-people me-1"></i>Trainers
        </a>
        <span class="separator">/</span>
        <span class="text-muted">Restore Trainer</span>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card plan-detail-card border-0">

                <div class="card-header text-center text-white">
                    <i class="bi bi-person-check display-4 mb-3 d-block"></i>

                    <h2 class="fw-bold mb-2">
                        Restore Trainer
                    </h2>

                    <span class="badge bg-success fs-6">
                        Activate Account
                    </span>
                </div>


                <div class="card-body">

                    <div class="detail-item">

                        <div class="d-flex align-items-start">

                            <div class="icon-box me-3">
                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                            </div>

                            <div>

                                <h6 class="mb-2 text-uppercase small fw-semibold">
                                    Confirmation
                                </h6>

                                <p class="mb-0">
                                    Are you sure you want to restore
                                    <strong>@Model.Name</strong>?
                                </p>

                                <p class="text-muted mb-0 mt-2">
                                    The Trainer will be activated again and will appear in active Trainer lists.
                                    All previous information will remain unchanged.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="card-footer">

                    <div class="d-flex gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline flex-fill">
                            <i class="bi bi-arrow-left me-1"></i>
                            Cancel
                        </a>


                        <form asp-action="Activate"
                              method="post"
                              class="flex-fill">

                            <button type="submit"
                                    class="btn btn-success w-100 h-100 rounded-pill">
                                <i class="bi bi-person-check me-1"></i>
                                Restore Trainer
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
