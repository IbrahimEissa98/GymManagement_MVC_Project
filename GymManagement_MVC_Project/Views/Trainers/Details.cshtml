@model TrainerDetailsViewModel

@{
	ViewData["Title"] = "Trainer Details";
}

<div class="container pt-5">

    <nav class="breadcrumb-nav mb-3 pt-5" aria-label="Breadcrumb">
        <a asp-controller="Trainers" asp-action="Index">
            <i class="bi bi-person-workspace me-1"></i>Trainers
        </a>
        <span class="separator">/</span>
        <span class="text-muted">Trainer Details</span>
    </nav>

    <div class="row justify-content-center">

        <div class="col-lg-8 col-md-10">

            <div class="card plan-detail-card border-0">

                <div class="card-header text-white text-center">

                    <i class="bi bi-person-badge display-4 mb-3 d-block"></i>

                    <h2 class="fw-bold mb-2">
                        @Model.Name
                    </h2>

                    <span class="badge bg-light text-primary-color fs-6">
                        @Model.Specialties Trainer
                    </span>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="detail-item h-100">

                                <div class="d-flex align-items-center">

                                    <div class="icon-box me-3">
                                        <i class="bi bi-envelope text-primary-color fs-4"></i>
                                    </div>

                                    <div>
                                        <h6 class="mb-1 text-uppercase small fw-semibold">
                                            Email
                                        </h6>

                                        <p class="mb-0 fw-bold">
                                            @Model.Email
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="detail-item h-100">

                                <div class="d-flex align-items-center">

                                    <div class="icon-box me-3">
                                        <i class="bi bi-telephone text-primary-color fs-4"></i>
                                    </div>

                                    <div>
                                        <h6 class="mb-1 text-uppercase small fw-semibold">
                                            Phone
                                        </h6>

                                        <p class="mb-0 fw-bold">
                                            @Model.Phone
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="detail-item h-100">

                                <div class="d-flex align-items-center">

                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-date text-primary-color fs-4"></i>
                                    </div>

                                    <div>
                                        <h6 class="mb-1 text-uppercase small fw-semibold">
                                            Date of Birth
                                        </h6>

                                        <p class="mb-0 fw-bold">
                                            @Model.DateOfBirth
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="detail-item h-100">

                                <div class="d-flex align-items-center">

                                    <div class="icon-box me-3">
                                        <i class="bi bi-gender-ambiguous text-primary-color fs-4"></i>
                                    </div>

                                    <div>
                                        <h6 class="mb-1 text-uppercase small fw-semibold">
                                            Gender
                                        </h6>

                                        <p class="mb-0 fw-bold">
                                            @Model.Gender
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="detail-item">

                                <div class="d-flex align-items-start">

                                    <div class="icon-box me-3">
                                        <i class="bi bi-geo-alt text-primary-color fs-4"></i>
                                    </div>

                                    <div>
                                        <h6 class="mb-1 text-uppercase small fw-semibold">
                                            Address
                                        </h6>

                                        <p class="mb-0 fw-bold">
                                            @Model.Address
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="d-flex gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline flex-fill">
                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Trainers
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@ViewContext.RouteData.Values["id"]"
                           class="btn get-started flex-fill">
                            <i class="bi bi-pencil me-1"></i>
                            Edit Trainer
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>