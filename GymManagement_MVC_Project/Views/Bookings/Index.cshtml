@model IReadOnlyList<BookingIndexViewModel>

@{
	ViewData["Title"] = "Bookings";
}

@section Styles {
	<style>
		.session-card {
			background-color: var(--surface-bg);
			color: var(--black-alternative);
			box-shadow: var(--shadow-sm);
			transition: transform var(--main-duration) ease, box-shadow var(--main-duration) ease;
		}

			.session-card:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow-md);
			}

			.session-card .card-header {
				border: none;
			}

			.session-card .card-body {
				background-color: var(--surface-bg);
			}

			.session-card .card-footer {
				background-color: var(--surface-bg);
				border-top: 1px solid var(--border-color) !important;
			}

			.session-card .info-item {
				color: var(--black-alternative);
			}

				.session-card .info-item strong {
					color: var(--black-alternative);
				}

			.session-card .text-muted {
				color: var(--text-muted-custom) !important;
			}

			.session-card .badge.bg-light {
				background-color: var(--surface-elevated) !important;
				color: var(--black-alternative) !important;
			}
	</style>
}

<div class="container pt-5">
	<main role="main" class="pb-3 pt-5">
		<partial name="_TempDataAlertMessage" />

		<div class="container">

			<header class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
				<div class="d-flex align-items-center gap-3">
					<div class="page-icon">
						<i class="bi bi-person-lines-fill"></i>
					</div>
					<div>
						<h2 class="text-primary-color mb-1 fw-bold">Booking Sessions</h2>
						<p class="text-muted mb-0">Session Valid For Manage Booking</p>
					</div>
				</div>
			</header>


			@if (Model != null && Model.Any())
			{
				<div class="row g-4">
					@foreach (var session in Model.OrderBy(s => s.Status))
					{
						<div class="col-12 col-md-6 col-lg-4">
							<div class="card h-100 border-0 session-card">

								<div class="card-header text-white py-3
									@(session.Status.ToString() == "Ongoing"
											? "bg-success"
											: session.Status.ToString() == "Upcoming"
												? "bg-primary-color"
												: "bg-secondary")
									@(session.IsDeleted ? "bg-danger" : "")">

									<div class="d-flex justify-content-between align-items-center">

										<h5 class="mb-0">
											<i class="bi bi-calendar-event me-2"></i>
											@session.CategoryName
										</h5>

										<span class="badge bg-light text-dark">
											@session.Status
										</span>

									</div>

								</div>


								<div class="card-body">

									<p class="text-muted mb-3">
										@session.Description
									</p>

									<div class="session-info mb-3">

										<div class="info-item mb-2">
											<i class="bi bi-person-circle text-primary-color me-2"></i>
											<strong>Trainer:</strong>
											@session.TrainerName
										</div>

										<div class="info-item mb-2">
											<i class="bi bi-calendar3 text-primary-color me-2"></i>
											<strong>Date:</strong>
											@session.Date
										</div>

										<div class="info-item mb-2">
											<i class="bi bi-clock text-primary-color me-2"></i>
											<strong>Time:</strong>
											@session.TimeDisplay
										</div>

										<div class="info-item mb-2">
											<i class="bi bi-hourglass-split text-primary-color me-2"></i>
											<strong>Duration:</strong>
											@session.Duration
										</div>

										<div class="info-item">
											<i class="bi bi-people text-primary-color me-2"></i>
											<strong>Capacity:</strong>
											@session.Capacity slots
										</div>

									</div>

								</div>


								<div class="card-footer border-0">

									<div class="d-grid gap-2">
										@if (session.Status == SessionStatus.Upcoming)
										{
											<a asp-action="ViewUpcoming"
											   asp-route-id="@session.Id"
											   class="btn btn-outline btn-sm">
												<i class="bi bi-eye me-1"></i>
												View Members
											</a>
										}
										else
										{
											<a asp-action="ViewOngoing"
											   asp-route-id="@session.Id"
											   class="btn btn-outline btn-sm">
												<i class="bi bi-eye me-1"></i>
												View Members
											</a>
										}
									</div>

								</div>

							</div>
						</div>
					}
				</div>
			}
			else
			{
				<div class="card plan-detail-card border-0">

					<div class="card-body text-center py-5">

						<i class="bi bi-calendar-x display-1 text-muted"></i>

						<h4 class="mt-3 fw-bold">
							No Sessions Available
						</h4>

						<p class="text-muted mb-4">
							Create your first training session to get started.
						</p>

						<a asp-controller="Sessions"
						   asp-action="Create"
						   class="btn get-started">
							<i class="bi bi-plus-lg me-2"></i>
							Add Session
						</a>

					</div>

				</div>
			}

		</div>
	</main>
</div>

@section Scripts {
	<partial name="_AlertDismissScript" />
}