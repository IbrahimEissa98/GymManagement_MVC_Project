@model BookingCreateViewModel

@{
	ViewData["Title"] = "Create Booking";
}

@section Styles {
	<partial name="_BootstrapValidationClassesStylePartial" />
}
<div class="container pt-5">
	<partial name="_TempDataAlertMessage" />
	<nav class="breadcrumb-nav mb-3 pt-5" aria-label="Breadcrumb">
		<a asp-controller="Bookings" asp-action="Index">
			<i class="bi bi-calendar-event me-1"></i>Bookings
		</a>
		<span class="separator">/</span>
		<a asp-controller="Bookings" asp-action="ViewMembers" 
		    asp-route-id="@ViewContext.RouteData.Values["id"]">
			Session Members
		</a>
		<span class="separator">/</span>
		<span class="text-muted">Create Booking</span>
	</nav>

	<div class="row justify-content-center">

		<div class="col-lg-10">

			<div class="card plan-detail-card border-0">

				<div class="card-header text-white text-center">
					<i class="bi bi-calendar-plus display-4 mb-3 d-block"></i>

					<h2 class="fw-bold mb-2">
						Create New Booking
					</h2>

					<p class="mb-0 opacity-75">
						<strong>Session: </strong>@Model.SessionDetails?.CategoryName
						<span class="text-success"> | </span>
						<strong>Trainer: </strong>@Model.SessionDetails?.TrainerName
						<br/>
						<strong>StartDate: </strong>@Model.SessionDetails?.StartDate
					</p>
				</div>

				<form asp-action="Create" method="post">
					<input asp-for="SessionId" type="hidden" value="@ViewContext.RouteData.Values["id"]" readonly/>

					<div class="card-body">
						<div class="detail-item mb-4">

							<h5 class="fw-bold text-primary-color mb-4">
								<i class="bi bi-info-circle me-2"></i>
								Booking Information
							</h5>

							<div class="row g-3">

								<div class="col-12 col-md-6">

									<label asp-for="MemberId"
										   class="form-label fw-semibold">
										Member
										<span class="text-danger">*</span>
									</label>

									<select asp-for="MemberId"
											asp-items="new SelectList(Model.Members, nameof(MemberLookupItem.Id), nameof(MemberLookupItem.Name))"
											class="form-select">

										<option disabled selected value="">
											-- Select Member --
										</option>

									</select>

									<span asp-validation-for="MemberId"
										  class="text-danger"></span>

								</div>
							</div>
						</div>
					</div>

					<!-- Footer -->
					<div class="card-footer">

						<div class="d-flex gap-2">

							<a asp-action="ViewUpcoming" 
							    asp-route-id="@ViewContext.RouteData.Values["id"]"
							    class="btn btn-outline flex-fill">

								<i class="bi bi-arrow-left me-1"></i>
								Cancel

							</a>

							<button type="submit"
									class="btn get-started flex-fill">

								<i class="bi bi-check-lg me-1"></i>
								Create Booking

							</button>

						</div>

					</div>

				</form>

			</div>

		</div>

	</div>

</div>


@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}