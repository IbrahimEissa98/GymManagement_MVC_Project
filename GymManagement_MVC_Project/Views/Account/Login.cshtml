@model AccountLoginViewModel
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<script>
			(function () {
			var t = localStorage.getItem('gym-theme');
			if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			document.documentElement.setAttribute('data-bs-theme', t);
			})();
	</script>

	<title>Power Fitness - Admin Login</title>

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
		  rel="stylesheet" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
	<link rel="icon" href="~/images/favicon.svg" type="image/x-icon" asp-append-version="true">
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

	<link rel="stylesheet" href="~/css/identity.css" />
	<partial name="_BootstrapValidationClassesStylePartial" />
</head>

<body>

	<div class="login-page">

		<div class="login-container">

			<!-- ================= LEFT ================= -->
			<section class="login-form-section">

				<div class="login-content">

					<!-- Logo -->
					<div class="logo-section">

						<div class="logo-icon">
							<i class="bi bi-lightning-charge-fill"></i>
						</div>

						<h1 class="brand-name">
							Power Fitness
						</h1>

						<p class="brand-subtitle">
							Gym Management System
						</p>

					</div>

					<!-- Title -->
					<div class="login-heading">

						<h2 class="login-title">
							Admin Login
						</h2>

						<p class="login-subtitle">
							Welcome back! Please login to your account
						</p>

					</div>


					<!-- Login Form -->
					<form class="needs-validation"
						  method="post"
						  asp-route-ReturnUrl="@Model.ReturnUrl"
						  id="loginForm">

                        
						<div class="text-danger bg-danger-subtle rounded-2" 
						asp-validation-summary="ModelOnly">
						</div>

						<input asp-for="ReturnUrl" type="hidden" />

						<!-- Email -->
						<div class="form-floating mb-3">

							<input asp-for="Email"
								   class="form-control"
								   placeholder="admin@example.com"
								   autocomplete="username" />

							<label asp-for="Email">
								<i class="bi bi-envelope me-2"></i>
								Email Address
							</label>

							<span asp-validation-for="Email"
								  class="text-danger small">
							</span>

						</div>


						<!-- Password -->
						<div class="form-floating pass mb-3">

							<div class="form-floating position-relative">
								<input asp-for="Password"
									   class="form-control"
									   placeholder="Password"
									   autocomplete="current-password" />

								<button type="button"
										id="togglePassword"
										class="btn password-toggle position-absolute top-0 bottom-0 end-0"
										aria-label="Show password">
									<i class="bi bi-eye"
									   id="passwordIcon">
									</i>
								</button>
								<label asp-for="Password">
									<i class="bi bi-lock-fill me-2"></i>
									Password
								</label>

							</div>

							<span asp-validation-for="Password"
								  class="text-danger small">
							</span>

						</div>


						<!-- Remember Me -->
						<div class="form-check mb-4">

							<input asp-for="RememberMe"
								   class="form-check-input" />

							<label asp-for="RememberMe"
								   class="form-check-label">
								Remember me for 24 hours
							</label>

						</div>


						<!-- Login -->
						<button type="submit"
								class="btn btn-login w-100"
								id="loginBtn">

							<i class="bi bi-box-arrow-in-right me-2"></i>
							Login to Dashboard

						</button>


						<!-- Demo / Complete Form -->
						<button type="button"
								class="btn btn-demo w-100 mt-3"
								id="fillFormBtn">

							<i class="bi bi-magic me-2"></i>
							Complete Form

						</button>

					</form>

				</div>

			</section>


			<!-- ================= RIGHT ================= -->
			<section class="gym-info-section">

				<div class="gym-content">

					<div class="gym-icon">
						<i class="bi bi-lightning-charge-fill"></i>
					</div>

					<h2 class="gym-title">

						Your body can
						<span>stand</span>
						almost anything

					</h2>

					<p class="gym-description">

						It's your mind that needs convincing.
						Push past your limits, stay committed,
						and watch as your body transforms into
						a powerhouse of strength and resilience.

					</p>


					<!-- Statistics -->
					<div class="stats-container">

						<div class="stat-item">

							<span class="stat-number">
								500+
							</span>

							<span class="stat-label">
								Members
							</span>

						</div>


						<div class="stat-item">

							<span class="stat-number">
								50+
							</span>

							<span class="stat-label">
								Trainers
							</span>

						</div>


						<div class="stat-item">

							<span class="stat-number">
								24/7
							</span>

							<span class="stat-label">
								Support
							</span>

						</div>

					</div>

				</div>

			</section>

		</div>

	</div>

	<!-- Scripts -->
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/theme.js" asp-append-version="true"></script>
	<partial name="_ValidationScriptsPartial" />

    <script>
        const emailInput = document.getElementById("Email");

        const passwordInput = document.getElementById("Password");

        const rememberMe = document.getElementById("RememberMe");

        const fillFormBtn = document.getElementById("fillFormBtn");

        const loginForm = document.getElementById("loginForm");

        const loginBtn = document.getElementById("loginBtn");

        const togglePassword = document.getElementById("togglePassword");

        const passwordIcon = document.getElementById("passwordIcon");

        document.addEventListener("DOMContentLoaded", function () {

        /*
        * Focus email when page loads
        */
        emailInput.focus();

        /*
        * Trigger input events so Bootstrap
        * floating labels update correctly.
        */
        emailInput.dispatchEvent(new Event("input", { bubbles: true }));

        passwordInput.dispatchEvent(new Event("input", { bubbles: true }));

        });

        /*
        * Complete the login form
        */
        fillFormBtn.addEventListener("click", function () {
        emailInput.value = "admin@gym.com";
        passwordInput.value = "Admin@123";
        rememberMe.checked = true;

        fillFormBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Form Completed';

        setTimeout(function () {
        fillFormBtn.innerHTML = '<i class="bi bi-magic me-2"></i>Complete Form';
        }, 1500);
        });

        if (passwordInput && togglePassword && passwordIcon) {
        togglePassword.addEventListener("click", function () {
        const isPassword = passwordInput.type === "password";

        passwordInput.type = isPassword ? "text" : "password";

        passwordIcon.classList.toggle("bi-eye", !isPassword);

        passwordIcon.classList.toggle("bi-eye-slash", isPassword);

        togglePassword.setAttribute(
        "aria-label",
        isPassword ? "Hide password" : "Show password",
        );
        });
        }

        /*
        * Prevent multiple login submissions
        */
        $(loginForm).on("submit", function () {
        if ($(this).valid()) {
        loginBtn.classList.add("loading");

        loginBtn.disabled = true;

        loginBtn.innerHTML =
        '<span class="spinner-border spinner-border-sm me-2"></span>' +
        "Logging in...";
        }
        });
    </script>
</body>

</html>