@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Access Denied - Power Fitness</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet"
          href="~/css/accessDenied.css">

</head>

<body>

    <main class="error-page">

        <div class="access-denied-card">

            <!-- =========================
                 Content
            ========================== -->

            <section class="error-content">

                <div class="error-icon-wrapper">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <h1 class="error-title">
                    Access <span class="error-highlight">Denied</span>
                </h1>

                <p class="error-message">
                    We're sorry, but you don't have permission to access
                    this resource. Your current user role or membership
                    status doesn't grant you access to this section.
                </p>

                <div class="error-code">
                    <i class="bi bi-exclamation-triangle"></i>
                    Error Code: 403 - Forbidden Access
                </div>

                <p class="error-message">
                    If you believe this is an error or need elevated
                    permissions, please contact the system administrator
                    or your membership manager for assistance.
                </p>

                <div class="button-group">

                    <a asp-action="Index"
                       asp-controller="Home"
                       class="btn-home">

                        <i class="bi bi-house-door-fill me-2"></i>
                        Return to Home

                    </a>
                    <button onclick="history.back()"
                            class="btn btn-outline-secondary px-4">

                        Go Back

                    </button>

                </div>

            </section>


            <!-- =========================
                 Visual
            ========================== -->

            <section class="error-visual">

                <div class="lock-container">

                    <i class="bi bi-lock-fill lock-icon"></i>

                </div>

                <span class="visual-text">
                    Restricted Area
                </span>

            </section>

        </div>

    </main>

</body>

</html>