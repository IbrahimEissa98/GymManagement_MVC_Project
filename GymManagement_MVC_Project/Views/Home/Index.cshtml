@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section pt-5">
    <div class="container pt-5">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-7 col-md-6 col-12 order-2 order-md-1">
                <div class="hero-text">
                    <h1 class="fw-bolder display-4 mb-4 text-black-alternative">
                        Your body can
                        <span class="text-primary-color">stand almost</span> anything
                    </h1>
                    <p class="mb-4">
                        It's your mind that needs convincing. Push past your limits, stay committed, and watch as your body
                        transforms into a powerhouse of strength and resilience. Start your journey today — become truly capable!
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-4">
                            <div class="stat-card">
                                <span class="stat-number d-block">100</span>
                                <p class="stat-label">Total Members</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-card">
                                <span class="stat-number d-block">85</span>
                                <p class="stat-label">Active Members</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-card">
                                <span class="stat-number d-block">20</span>
                                <p class="stat-label">Trainers</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-card">
                                <span class="stat-number d-block">3</span>
                                <p class="stat-label">Upcoming Sessions</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-card">
                                <span class="stat-number d-block">5</span>
                                <p class="stat-label">Ongoing Sessions</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-card">
                                <span class="stat-number d-block">20</span>
                                <p class="stat-label">Completed Sessions</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <button class="get-started btn">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Get Started
                        </button>
                        <button class="explore-more btn">
                            Explore More <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 col-md-6 col-12 order-1 order-md-2">
                <div class="character d-flex justify-content-center">
                    <img src="~/images/Theo Vance.jpg" alt="Theo Vance - Fitness Trainer" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Marquee Bar -->
<div class="marquee-bar bg-primary-color py-4 text-white fw-bold">
    <div class="marquee-track">
        <span>
            outdoor &amp; online trainers <img src="~/images/star.svg" alt="" /> personal training
            <img src="~/images/star.svg" alt="" /> live classes <img src="~/images/star.svg" alt="" /> personal trainers
            <img src="~/images/star.svg" alt="" /> group workouts <img src="~/images/star.svg" alt="" />
        </span>
        <span>
            outdoor &amp; online trainers <img src="~/images/star.svg" alt="" /> personal training
            <img src="~/images/star.svg" alt="" /> live classes <img src="~/images/star.svg" alt="" /> personal trainers
            <img src="~/images/star.svg" alt="" /> group workouts <img src="~/images/star.svg" alt="" />
        </span>
        <span>
            outdoor &amp; online trainers <img src="~/images/star.svg" alt="" /> personal training
            <img src="~/images/star.svg" alt="" /> live classes <img src="~/images/star.svg" alt="" /> personal trainers
            <img src="~/images/star.svg" alt="" /> group workouts <img src="~/images/star.svg" alt="" />
        </span>
    </div>
</div>

<main role="main">

    <!-- About Section -->
    <section class="about py-5 text-black-alternative">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6">
                    <div class="characters position-relative">
                        <div class="image">
                            <img class="img-fluid rounded-4 shadow" src="./images/about p1.jpg" alt="Gym member training" />
                        </div>
                        <div class="image position-absolute d-none d-lg-block">
                            <img class="img-fluid rounded-3 shadow" src="./images/about p2.jpg" alt="Fitness session" />
                        </div>
                        <div class="image position-absolute d-none d-lg-block">
                            <img class="img-fluid rounded-3 shadow" src="./images/about p3.jpg" alt="Group workout" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="section-badge">
                        <img src="~/images/dumbbell.jpg" alt="" />
                        <h2 class="text-primary-color fs-6 fw-bold mb-0 text-uppercase">About Us</h2>
                    </div>

                    <h2 class="fw-bolder display-6 mb-4">
                        EMPOWERING YOU TO ACHIEVE
                        <span class="text-primary-color">YOUR FITNESS</span> GOALS
                    </h2>
                    <p class="text mb-4">
                        We believe fitness is more than just a workout — it's a lifestyle. With top-of-the-line facilities,
                        certified trainers, and a supportive community, we're here to inspire and guide you every step of the way.
                    </p>

                    <div class="row row-cols-1 row-cols-sm-2 g-3">
                        <div class="col">
                            <div class="feature-card">
                                <div class="title d-flex align-items-center gap-2 mb-2">
                                    <img src="~/images/feature icon.jpg" alt="" />
                                    <h3>Personal Trainer</h3>
                                </div>
                                <div class="info">
                                    <p>Achieve your fitness goals with the guidance of our certified trainers.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="feature-card">
                                <div class="title d-flex align-items-center gap-2 mb-2">
                                    <img src="~/images/feature icon.jpg" alt="" />
                                    <h3>Group Classes</h3>
                                </div>
                                <div class="info">
                                    <p>Join energizing group sessions and stay motivated with the community.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="feature-card">
                                <div class="title d-flex align-items-center gap-2 mb-2">
                                    <img src="~/images/feature icon.jpg" alt="" />
                                    <h3>Nutrition Plans</h3>
                                </div>
                                <div class="info">
                                    <p>Fuel your progress with personalized nutrition guidance and meal plans.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="feature-card">
                                <div class="title d-flex align-items-center gap-2 mb-2">
                                    <img src="~/images/feature icon.jpg" alt="" />
                                    <h3>Modern Equipment</h3>
                                </div>
                                <div class="info">
                                    <p>Train with state-of-the-art equipment in a world-class facility.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn get-started mt-4">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Get Started
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Workout Section -->
    <section class="workout">
        <div class="container">
            <div class="title">
                <h2>WORKOUTS</h2>
                <p class="text-white fw-bold fs-4 mb-0">
                    Transform Your Body with Our Dynamic Upcoming Workouts
                </p>
            </div>

            <div class="row row-cols-1 row-cols-md-3 g-4">
                <div class="col">
                    <div class="card workout-card">
                        <img src="~/images/workout 1.jpg" class="card-img-top" alt="Group workout session" />
                        <div class="card-footer">
                            <h5 class="card-title text-black-alternative text-uppercase fw-bold mb-2">Group Workout</h5>
                            <a href="#">Explore <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card workout-card">
                        <img src="~/images/workout 2.jpg" class="card-img-top" alt="Strength training" />
                        <div class="card-footer">
                            <h5 class="card-title text-black-alternative text-uppercase fw-bold mb-2">Strength Training</h5>
                            <a href="#">Explore <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card workout-card">
                        <img src="~/images/workout 3.jpg" class="card-img-top" alt="Cardio fitness" />
                        <div class="card-footer">
                            <h5 class="card-title text-black-alternative text-uppercase fw-bold mb-2">Cardio Fitness</h5>
                            <a href="#">Explore <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="indicators">
                <div class="indicator"></div>
                <div class="indicator active"></div>
                <div class="indicator"></div>
                <div class="indicator"></div>
            </div>
        </div>
    </section>

    <!-- Why Us Section -->
    <section class="why-us py-5">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6">
                    <div class="section-badge">
                        <img src="~/images/dumbbell.jpg" alt="" />
                        <h2 class="text-primary-color fs-6 fw-bold mb-0 text-uppercase">Why Us</h2>
                    </div>

                    <h2 class="fw-bolder display-5 mb-4 text-black-alternative">
                        Elevate fitness with<br />
                        <span class="text-primary-color">the best</span> way possible
                    </h2>
                    <p class="text mb-4">
                        We believe fitness is more than just a workout — it's a lifestyle. With top-of-the-line facilities,
                        certified trainers, and a supportive community, we're here to inspire and guide you every step of the way.
                    </p>

                    <ul class="list-unstyled d-flex flex-column gap-3">
                        <li class="feature d-flex gap-3 align-items-start">
                            <div class="count">01</div>
                            <div>
                                <h3 class="text-capitalize fw-bold mb-1">Personalized Fitness Plans</h3>
                                <p class="fs-18 mb-0">
                                    We tailor every workout to fit your unique goals and fitness level, ensuring you make the most progress.
                                </p>
                            </div>
                        </li>
                        <li class="feature d-flex gap-3 align-items-start">
                            <div class="count">02</div>
                            <div>
                                <h3 class="text-capitalize fw-bold mb-1">Expert Certified Trainers</h3>
                                <p class="fs-18 mb-0">
                                    Our team of certified professionals brings years of experience to help you train safely and effectively.
                                </p>
                            </div>
                        </li>
                        <li class="feature d-flex gap-3 align-items-start">
                            <div class="count">03</div>
                            <div>
                                <h3 class="text-capitalize fw-bold mb-1">Supportive Community</h3>
                                <p class="fs-18 mb-0">
                                    Join a motivating community that celebrates every milestone and keeps you accountable on your journey.
                                </p>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-6 d-none d-lg-block">
                    <img class="img-fluid" src="./images/why us images.svg" alt="Fitness community illustration" />
                </div>
            </div>
        </div>
    </section>
</main>

<!-- Footer -->
<footer class="site-footer">
    <div class="marquee-bar bg-primary-color py-4 text-white fw-bold">
        <div class="marquee-track">
            <span>
                outdoor &amp; online trainers <img src="~/images/star.svg" alt="" /> personal training
                <img src="~/images/star.svg" alt="" /> live classes <img src="~/images/star.svg" alt="" /> personal trainers
                <img src="~/images/star.svg" alt="" /> group workouts <img src="~/images/star.svg" alt="" />
            </span>
            <span>
                outdoor &amp; online trainers <img src="~/images/star.svg" alt="" /> personal training
                <img src="~/images/star.svg" alt="" /> live classes <img src="~/images/star.svg" alt="" /> personal trainers
                <img src="~/images/star.svg" alt="" /> group workouts <img src="~/images/star.svg" alt="" />
            </span>
        </div>
    </div>

    <div class="footer-content py-5">
        <div class="container">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                <div class="logo">
                    <img src="~/images/logo.jpg" alt="Power Fitness logo" class="mb-3" />
                    <p class="fs-18">
                        Push harder, go further. Your fitness journey starts today!
                    </p>
                </div>

                <div class="contact">
                    <h4 class="fw-bold text-uppercase mb-3">Contact Us</h4>
                    <ul class="d-flex flex-column gap-3">
                        <li class="d-flex align-items-center gap-2">
                            <div class="icon-box">
                                <i class="bi bi-telephone-fill text-primary-color"></i>
                            </div>
                            <p>+91 123 456 789</p>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <div class="icon-box">
                                <i class="bi bi-envelope-fill text-primary-color"></i>
                            </div>
                            <p>info@gmail.com</p>
                        </li>
                    </ul>
                </div>

                <div class="time">
                    <h4 class="fw-bold text-uppercase mb-3">Our Gym Timing</h4>
                    <p class="mb-0">
                        Mon - Fri : 08:00 AM - 10:00 PM<br />
                        Sat - Sun : 08:00 AM - 09:00 PM
                    </p>
                </div>

                <div class="location">
                    <h4 class="fw-bold text-uppercase mb-3">Our Location</h4>
                    <p class="mb-0">
                        <i class="bi bi-geo-alt-fill text-primary-color me-1"></i>
                        2715 Ash Dr. San Jose, South Dakota 83475
                    </p>
                </div>
            </div>
        </div>
    </div>
</footer>