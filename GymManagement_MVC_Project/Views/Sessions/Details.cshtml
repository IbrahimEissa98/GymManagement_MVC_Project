@model SessionDetailsViewModel

@{
	ViewData["Title"] = "Session Details";
}

@section Styles {
	<style>
		.session-status-ongoing {
			background-color: var(--bs-success);
		}

		.session-status-upcoming {
			background-color: var(--primary-color);
		}

		.session-status-completed {
			background-color: var(--bs-secondary-color);
		}

		.session-status-badge {
			background-color: var(--surface-elevated);
			color: var(--black-alternative);
		}
	</style>
}

<div class="container pt-5">

	<nav class="breadcrumb-nav mb-3 pt-5" aria-label="Breadcrumb">
		<a asp-controller="Sessions" asp-action="Index">
			<i class="bi bi-calendar-event me-1"> </i> Training Sessions
		</a>
		<span class="separator"> /</span>
		<span class="text-muted"> Session Details</span>
	</nav>

	<div class="row justify-content-center">

		<div class="col-lg-8 col-md-10">

			<div class="card plan-detail-card border-0">
				<!-- Header -->
				<div class=" py-4
					@(Model.Status.ToString() == "Ongoing"
						  ? "session-status-ongoing"
						  : Model.Status.ToString() == "Upcoming"
							  ? "session-status-upcoming"
							  : "session-status-completed")
					text-white text-center">
					<i class="bi bi-calendar-event display-4 mb-3 d-block"> </i>

					<h2 class="mb-2 fw-bold">
						@Model.CategoryName
					</h2>

					<span class="badge bg-light text-dark fs-6">
						@Model.Status
					</span>

				</div>
				<!-- Body -->
				<div class="card-body">
					<!-- Description -->
					<div class="detail-item mb-4">

						<div class="d-flex align-items-start">

							<div class="icon-box me-3">
								<i class="bi bi-file-text text-primary-color fs-4"> </i>
							</div>

							<div class="flex-grow-1">

								<h6 class="mb-2 text-uppercase small fw-semibold">
									Description
								</h6>

								<p class="mb-0">
									@Model.Description
								</p>

							</div>

						</div>

					</div>
					<!-- Session Information -->
					<div class="row g-3">
						<!-- Trainer -->
						<div class="col-12 col-md-6">

							<div class="detail-item h-100">

								<div class="d-flex align-items-center">

									<div class="icon-box me-3">
										<i class="bi bi-person-circle text-primary-color fs-4"> </i>
									</div>

									<div>

										<h6 class="mb-1 text-uppercase small fw-semibold">
											Trainer
										</h6>

										<p class="mb-0 fw-bold">
											@Model.TrainerName
										</p>

									</div>

								</div>

							</div>

						</div>
						<!-- Capacity -->
						<div class="col-12 col-md-6">

							<div class="detail-item h-100">

								<div class="d-flex align-items-center">

									<div class="icon-box me-3">
										<i class="bi bi-people text-primary-color fs-4"> </i>
									</div>

									<div>

										<h6 class="mb-1 text-uppercase small fw-semibold">
											Capacity
										</h6>

										<p class="mb-0 fw-bold">
											@Model.BookedCount / @Model.Capacity spots
										</p>

									</div>

								</div>

							</div>

						</div>
						<!-- Start Time -->
						<div class="col-12 col-md-6">

							<div class="detail-item h-100">

								<div class="d-flex align-items-center">

									<div class="icon-box me-3">
										<i class="bi bi-calendar-check text-primary-color fs-4"> </i>
									</div>

									<div>

										<h6 class="mb-1 text-uppercase small fw-semibold">
											Start Time
										</h6>

										<p class="mb-0 fw-bold">
											@Model.StartDate
										</p>

									</div>

								</div>

							</div>

						</div>
						<!-- End Time -->
						<div class="col-12 col-md-6">

							<div class="detail-item h-100">

								<div class="d-flex align-items-center">

									<div class="icon-box me-3">
										<i class="bi bi-calendar-x text-primary-color fs-4"> </i>
									</div>

									<div>

										<h6 class="mb-1 text-uppercase small fw-semibold">
											End Time
										</h6>

										<p class="mb-0 fw-bold">
											@Model.EndDate
										</p>

									</div>

								</div>

							</div>

						</div>
						<!-- Duration -->
						<div class="col-12">

							<div class="detail-item">

								<div class="d-flex align-items-center">

									<div class="icon-box me-3">
										<i class="bi bi-hourglass-split text-primary-color fs-4"> </i>
									</div>

									<div>

										<h6 class="mb-1 text-uppercase small fw-semibold">
											Duration
										</h6>

										<p class="mb-0 fw-bold fs-5 text-primary-color">
											@Model.Duration.Hours Hours
											@Model.Duration.Minutes Minutes
										</p>

									</div>

								</div>

							</div>

						</div>

					</div>

				</div>
				<!-- Footer -->
				<div class="card-footer">

					<div class="d-flex gap-2">

						<a asp-action="Index"
						   class="btn btn-outline flex-fill">

							<i class="bi bi-arrow-left me-1"> </i>
							Back to Sessions

						</a>

						<a asp-action="Edit"
						   asp-route-id="@Model.Id"
						   class="btn get-started flex-fill">

							<i class="bi bi-pencil me-1"> </i>
							Edit Session

						</a>

					</div>

				</div>

			</div>

		</div>

	</div>

</div>
