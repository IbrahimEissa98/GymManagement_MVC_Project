@model HealthRecordDetailsViewModel

@{
	ViewData["Title"] = "Member Health Record";
}

@section Styles {
	<partial name="_CardDisplayStylePartial" />
}

<div class="container pt-5">

	<nav class="breadcrumb-nav mb-3 pt-5" aria-label="Breadcrumb">
		<a asp-controller="Members" asp-action="Index">
			<i class="bi bi-people me-1"></i>Members
		</a>
		<span class="separator">/</span>
		<span class="text-muted">Health Record</span>
	</nav>

	<div class="row justify-content-center">
		<div class="col-lg-8 col-md-10">

			<div class="card plan-detail-card border-0">

				<div class="card-header text-center text-white">

					<img src="@(string.IsNullOrWhiteSpace(Model.PhotoUrl)
														 ? Url.Content("~/images/User.jpg")
														 : Url.Action("Photo", "Members", new { storageKey = Model.PhotoUrl }))"
						 class="member-photo"
						 alt="@Model.Name" />

					<h2 class="fw-bold mt-3 mb-0">@Model.Name</h2>

				</div>

				<div class="card-body">

					<div class="plan-details">

						<div class="row g-3">

							<div class="col-md-6">
								<div class="detail-item h-100">
									<div class="d-flex align-items-center">
										<div class="icon-box me-3">
											<i class="bi bi-rulers text-primary-color fs-4"></i>
										</div>

										<div>
											<h6 class="mb-1 text-uppercase small fw-semibold">
												Height
											</h6>

											<p class="mb-0 fw-bold fs-5">
												@Model.Height cm
											</p>
										</div>
									</div>
								</div>
							</div>

							<div class="col-md-6">
								<div class="detail-item h-100">
									<div class="d-flex align-items-center">
										<div class="icon-box me-3">
											<i class="bi bi-speedometer2 text-primary-color fs-4"></i>
										</div>

										<div>
											<h6 class="mb-1 text-uppercase small fw-semibold">
												Weight
											</h6>

											<p class="mb-0 fw-bold fs-5">
												@Model.Weight kg
											</p>
										</div>
									</div>
								</div>
							</div>

							<div class="col-md-6">
								<div class="detail-item h-100">
									<div class="d-flex align-items-center">
										<div class="icon-box me-3">
											<i class="bi bi-droplet-fill text-danger fs-4"></i>
										</div>

										<div>
											<h6 class="mb-1 text-uppercase small fw-semibold">
												Blood Type
											</h6>

											<p class="mb-0 fw-bold fs-5">
												@Model.BloodType
											</p>
										</div>
									</div>
								</div>
							</div>

							<div class="col-md-6">
								<div class="detail-item h-100">
									<div class="d-flex align-items-start">
										<div class="icon-box me-3">
											<i class="bi bi-journal-text text-primary-color fs-4"></i>
										</div>

										<div class="flex-grow-1">
											<h6 class="mb-2 text-uppercase small fw-semibold">
												Note
											</h6>

											<p class="mb-0">
												@(string.IsNullOrWhiteSpace(Model.Note)
													? "No notes available."
													: Model.Note)
											</p>
										</div>
									</div>
								</div>
							</div>

						</div>

					</div>

				</div>

				<div class="card-footer">
					<div class="d-flex gap-2">

						<a asp-action="Index"
						   class="btn btn-outline flex-fill">
							<i class="bi bi-arrow-left me-1"></i>
							Back to Members
						</a>

					</div>
				</div>

			</div>

		</div>
	</div>

</div>
