@model MemberDetailsViewModel

@{
	ViewData["Title"] = "Member Details";
}

@section Styles {
	<partial name="_CardDisplayStylePartial" />
}

<div class="container pt-5">
	<main role="main" class="pb-3 pt-5">

		<nav class="breadcrumb-nav mb-3" aria-label="Breadcrumb">
			<a asp-controller="Members" asp-action="Index"><i class="bi bi-people me-1"></i>Members</a>
			<span class="separator">/</span>
			<span class="text-muted">Member Details</span>
		</nav>

		<div class="container">

			<div class="row justify-content-center">
				<div class="col-lg-8 col-md-10">

					<div class="card plan-detail-card border-0">

						<div class="card-header text-center text-white">

							<img src="@(string.IsNullOrWhiteSpace(Model.PhotoUrl)
								 ? Url.Content("~/images/User.jpg")
								 : Url.Action("Photo", "Members", new { storageKey = Model.PhotoUrl }))"
								 onerror="this.onerror=null; this.src='@Url.Content("~/images/User.jpg")';"
								 class="rounded-circle member-photo shadow"
								 alt="@Model.Name" />

							<h2 class="fw-bold mt-3 mb-2">@Model.Name</h2>

							<span class="badge @(Model.PlanName is null ? "bg-secondary" : "bg-success") fs-6">
								@(Model.PlanName ?? "No Active Plan")
							</span>

						</div>

						<div class="card-body">

							<div class="plan-details d-flex flex-column gap-3">

								<div class="detail-item">
									<div class="d-flex align-items-center">
										<div class="icon-box me-3">
											<i class="bi bi-envelope text-primary-color fs-4"></i>
										</div>

										<div>
											<h6 class="mb-1 text-uppercase small fw-semibold">
												Email
											</h6>
											<p class="mb-0 fw-bold">@Model.Email</p>
										</div>
									</div>
								</div>

								<div class="detail-item">
									<div class="d-flex align-items-center">
										<div class="icon-box me-3">
											<i class="bi bi-telephone text-primary-color fs-4"></i>
										</div>

										<div>
											<h6 class="mb-1 text-uppercase small fw-semibold">
												Phone
											</h6>
											<p class="mb-0 fw-bold">@Model.Phone</p>
										</div>
									</div>
								</div>

								<div class="detail-item">
									<div class="row">

										<div class="col-md-6">
											<div class="d-flex align-items-center">

												<div class="icon-box me-3">
													<i class="bi bi-gender-ambiguous text-primary-color fs-4"></i>
												</div>

												<div>
													<h6 class="mb-1 text-uppercase small fw-semibold">
														Gender
													</h6>
													<p class="mb-0 fw-bold">@Model.Gender</p>
												</div>

											</div>
										</div>

										<div class="col-md-6 mt-3 mt-md-0">
											<div class="d-flex align-items-center">

												<div class="icon-box me-3">
													<i class="bi bi-calendar-date text-primary-color fs-4"></i>
												</div>

												<div>
													<h6 class="mb-1 text-uppercase small fw-semibold">
														Date of Birth
													</h6>
													<p class="mb-0 fw-bold">@Model.DateOfBirth</p>
												</div>

											</div>
										</div>

									</div>
								</div>

								<div class="detail-item">
									<div class="row">

										<div class="col-md-6">
											<div class="d-flex align-items-center">

												<div class="icon-box me-3">
													<i class="bi bi-calendar-check text-primary-color fs-4"></i>
												</div>

												<div>
													<h6 class="mb-1 text-uppercase small fw-semibold">
														Membership Start
													</h6>
													<p class="mb-0 fw-bold">
														@(Model.MembershipStartDate ?? "Not Registered")
													</p>
												</div>

											</div>
										</div>

										<div class="col-md-6 mt-3 mt-md-0">
											<div class="d-flex align-items-center">

												<div class="icon-box me-3">
													<i class="bi bi-calendar-x text-primary-color fs-4"></i>
												</div>

												<div>
													<h6 class="mb-1 text-uppercase small fw-semibold">
														Membership End
													</h6>
													<p class="mb-0 fw-bold">
														@(Model.MembershipEndDate ?? "Not Registered")
													</p>
												</div>

											</div>
										</div>

									</div>
								</div>

								<div class="detail-item">
									<div class="d-flex align-items-start">

										<div class="icon-box me-3">
											<i class="bi bi-geo-alt text-primary-color fs-4"></i>
										</div>

										<div class="flex-grow-1">
											<h6 class="mb-2 text-uppercase small fw-semibold">
												Address
											</h6>

											<p class="mb-0">
												@Model.Address
											</p>
										</div>

									</div>
								</div>

							</div>

						</div>

						<div class="card-footer">
							<div class="d-flex gap-2">

								<a asp-action="Index"
								   class="btn btn-outline flex-fill">
									<i class="bi bi-arrow-left me-1"></i>
									Back to Members
								</a>

								<a asp-action="Edit"
								   asp-route-id="@Model.Id"
								   class="btn get-started flex-fill">
									<i class="bi bi-pencil me-1"></i>
									Edit Member
								</a>

							</div>
						</div>

					</div>

				</div>
			</div>

		</div>

	</main>
</div>
