@model IEnumerable<MemberIndexViewModel>

@{
	ViewData["Title"] = "Members";
}

<div class="container pt-5">
	<main role="main" class="pb-3 pt-5">
		<partial name="_TempDataAlertMessage" />

		<div class="container">

			<header class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
				<div class="d-flex align-items-center gap-3">
					<div class="page-icon">
						<i class="bi bi-person-lines-fill"></i>
					</div>
					<div>
						<h2 class="text-primary-color mb-1 fw-bold">Members</h2>
						<p class="text-muted mb-0">Manage your gym members information</p>
					</div>
				</div>
				<a asp-controller="Members" asp-action="Create" class="btn get-started btn-sm">
					<i class="bi bi-plus-lg me-1"></i>Add New Member
				</a>
			</header>

			<div class="card plan-detail-card border-0 overflow-visible">
				<div class="card-header py-2 d-flex justify-content-between align-items-center">

					<h5 class="mb-0 text-white">
						<i class="bi bi-person-workspace me-2"></i>
						Members
					</h5>

					<span class="badge bg-light text-dark">
						@Model.Count() Member(s)
					</span>

				</div>

				@if (Model.Any())
				{
					<div class="table-responsive" style="overflow: visible;">
						<table class="table align-middle mb-0">
							<thead>
								<tr>
									<th><span>Photo</span></th>
									<th><span>Name</span></th>
									<th><span>Email</span></th>
									<th><span>Gender</span></th>
									<th><span>Phone</span></th>
									<th class="text-center"><span>Action</span></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var member in Model)
								{
									<tr class="align-middle @(member.IsDeleted ? "table-danger" : "")">
										<td>
											<span class="avatar">
												<img src="@(string.IsNullOrWhiteSpace(member.PhotoUrl) 
													? Url.Content("~/images/User.jpg") 
													: Url.Action("Photo", "Members", new {storageKey = member.PhotoUrl}))" 
													alt="Default Avatar" class="rounded-circle"
													 style="width: 40px; height: 40px;" />
											</span>
										</td>
										<td><span>@member.Name</span></td>
										<td><span>@member.Email</span></td>
										<td><span>@member.Gender</span></td>
										<td><span>@member.Phone</span></td>
										<td class="action position-relative text-center">
											<div class="dropdown">
												<button class="btn btn-link btn-outline-secondary border-0 fs-5" type="button"
														id="dropdownMenuButton-@member.Id" data-bs-toggle="dropdown"
														aria-expanded="false">
													<i class="bi bi-three-dots"></i>
												</button>
												<ul class="dropdown-menu dropdown-menu-start"
													aria-labelledby="dropdownMenuButton-member.Id">
													@if (!member.IsDeleted)
													{
														<li>
															<a asp-controller="Members" asp-action="Details" asp-route-id="@member.Id"
															   class="dropdown-item d-flex align-items-center gap-3">
																<i class="bi bi-exclamation-circle text-warning"></i>
																<span>View Data</span>
															</a>
														</li>
														<li>
															<a asp-controller="Members" asp-action="HealthDetails" asp-route-id="@member.Id"
															   class="dropdown-item d-flex align-items-center gap-3">
																<i class="bi bi-exclamation-circle text-warning"></i>
																<span>View Health Record Data</span>
															</a>
														</li>
														<li>
															<hr class="dropdown-divider">
														</li>
														<li>
															<a asp-controller="Members" asp-action="Edit" asp-route-id="@member.Id"
															   class="dropdown-item d-flex align-items-center gap-3">
																<i class="bi bi-pencil-square text-success"></i>
																<span>Edit Data</span>
															</a>
														</li>
														<li>
															<hr class="dropdown-divider">
														</li>
														<li>
															<a asp-controller="Members" asp-action="Delete" asp-route-id="@member.Id"
															   class="dropdown-item d-flex align-items-center gap-3 text-danger">
																<i class="bi bi-x-circle text-danger"></i>
																<span>Delete</span>
															</a>
														</li>
													}
													else
													{
														<li>
															<a asp-controller="Members" asp-action="Activate" asp-route-id="@member.Id"
															   class="dropdown-item d-flex align-items-center gap-3 text-warning">
																<i class="bi bi-check2-circle text-warning"></i>
																<span>Activate</span>
															</a>
														</li>
													}
												</ul>
											</div>
										</td>
									</tr>
								}

							</tbody>
						</table>
					</div>
				}
				else
				{
					<div class="text-center py-5">
						<i class="bi bi-person-workspace display-1 text-muted"></i>
						<h4 class="mt-3 text-muted">No Members Available</h4>
						<p class="text-muted">Add your first Member to get started</p>
					</div>
				}

			</div>
		</div>
	</main>
</div>

@section Scripts {
	<partial name="_AlertDismissScript" />
}
