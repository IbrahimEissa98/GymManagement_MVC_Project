@model MemberCreateViewModel

@{
	ViewData["Title"] = "Member Create";
}

@section Styles{
	<partial name="_BootstrapValidationClassesStylePartial" />
}

<div class="container pt-5">
	<main role="main" class="pb-3 pt-4">

		<nav class="breadcrumb-nav mb-3" aria-label="Breadcrumb">
			<a asp-controller="Members" asp-action="Index"><i class="bi bi-people me-1"></i>Members</a>
			<span class="separator">/</span>
			<span class="text-muted">Add New Member</span>
		</nav>

		<header class="page-header py-3 d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
			<div class="d-flex align-items-center gap-3">
				<div class="page-icon">
					<i class="bi bi-person-fill-add"></i>
				</div>
				<div>
					<h2 class="text-primary-color mb-1 fw-bold">Add Member</h2>
				</div>
			</div>
		</header>

		<form method="post" class="needs-validation">

			<!-- Member Info -->
			<div class="section-header mb-3">
				<h5 class="text-primary fw-bold">Personal Information</h5>
				<hr class="mt-2">
			</div>
			<div class="row g-3">
				<div class="col-12 col-md-6">
					<label asp-for="Name" class="form-label">Name</label>
					<input asp-for="Name" class="form-control" required />
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="Email" class="form-label">Email</label>
					<input asp-for="Email" type="text" class="form-control" />
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="Phone" class="form-label">Phone</label>
					<input asp-for="Phone" type="text" class="form-control" />
					<span asp-validation-for="Phone" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="DateOfBirth" class="form-label">DateOfBirth</label>
					<input asp-for="DateOfBirth" class="form-control" type="date" />
					<span asp-validation-for="DateOfBirth" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="Gender" class="form-label">Gender</label>
					<select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<GenderTypes>()">
						<option selected disabled value="">-- Select Gender --</option>
					</select>
					<span asp-validation-for="Gender" class="text-danger"></span>
				</div>
			</div>
			<div class="section-header mb-3 mt-4">
				<h5 class="text-primary fw-bold">Address Information</h5>
				<hr class="mt-2">
			</div>
			<div class="row g-3">

				<div class="col-12 col-md-6">
					<label asp-for="BuildingNumber" class="form-label">BuildingNumber</label>
					<input asp-for="BuildingNumber" class="form-control" />
					<span asp-validation-for="BuildingNumber" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="Street" class="form-label">Street</label>
					<input asp-for="Street" class="form-control" />
					<span asp-validation-for="Street" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="City" class="form-label">City</label>
					<input asp-for="City" class="form-control" />
					<span asp-validation-for="City" class="text-danger"></span>
				</div>
			</div>

			<!-- Health Data -->
			<div class="section-header mb-3 mt-4">
				<h5 class="text-primary fw-bold">Health Information</h5>
				<hr class="mt-2">
			</div>

			<div class="row g-3">
				<div class="col-12 col-md-6">
					<label asp-for="HealthRecord.Height" class="form-label">Height</label>
					<input asp-for="HealthRecord.Height"  class="form-control" />
					<span asp-validation-for="HealthRecord.Height" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="HealthRecord.Weight" class="form-label">Weight</label>
					<input asp-for="HealthRecord.Weight" class="form-control" />
					<span asp-validation-for="HealthRecord.Weight" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="HealthRecord.BloodType" class="form-label">Blood Type</label>
					<select asp-for="HealthRecord.BloodType" class="form-select" asp-items="Html.GetEnumSelectList<BloodTypes>()">
						<option selected disabled value="">-- Select --</option>
					</select>
					<span asp-validation-for="HealthRecord.BloodType" class="text-danger"></span>
				</div>

				<div class="col-12 col-md-6">
					<label asp-for="HealthRecord.Note" class="form-label">Note</label>
					<input asp-for="HealthRecord.Note" class="form-control" />
				</div>
			</div>


			<footer class="d-flex justify-content-end gap-3 mt-4">
				<a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary px-4">
					<i class="bi bi-arrow-left me-2"></i> Back to List
				</a>

				<button type="submit" class="btn btn-primary px-4">
					<i class="bi bi-plus-circle me-2"></i> Add
				</button>
			</footer>

		</form>

	</main>
</div>


@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		// Preview photo before upload
		document.getElementById('photoInput').addEventListener('change', function (e) {
			var file = e.target.files[0];
			if (file) {
				var reader = new FileReader();
				reader.onload = function (e) {
					var preview = document.getElementById('photoPreview');
					preview.src = e.target.result;
					preview.style.display = 'block';
				}
				reader.readAsDataURL(file);
			}
		});
	</script>
	<script>
		document.querySelectorAll(".form-control").forEach(input =>{
		    if (input.classList.contains("input-validation-error")) {
				input.classList.replace("is-valid", "is-invalid");
				// input.classList.add("is-invalid");
		    } else if (input.classList.contains("valid")) {
				input.classList.remove("is-invalid");
				input.classList.add("is-valid");
		    }
		})
	</script>
}
