@model PlanEditViewModel

@{
	ViewData["Title"] = "Edit Plan";
}

@section Styles {
    <partial name="_CardDisplayStylePartial" />
    <partial name="_BootstrapValidationClassesStylePartial" />
}

<div class="container pt-5">

    <nav class="breadcrumb-nav mb-3 pt-5" aria-label="Breadcrumb">
        <a asp-action="Index">
            <i class="bi bi-card-checklist me-1"></i>Plans
        </a>
        <span class="separator">/</span>
        <span class="text-muted">Edit Plan</span>
    </nav>

    <div class="row justify-content-center">

        <div class="col-lg-8 col-md-10">

            <div class="card plan-detail-card border-0">

                <div class="card-header text-center text-white">
                    <i class="bi bi-pencil-square display-4 mb-3 d-block"></i>

                    <h2 class="fw-bold mb-2">
                        Edit Plan
                    </h2>

                    <p class="mb-0 opacity-75">
                        Update the plan information below.
                    </p>
                </div>

                <form id="updateForm" asp-action="Edit" method="post">

                    <div class="card-body">

                        <div class="row g-3">

                            <div class="col-12">
                                <div class="detail-item h-100">

                                    <label asp-for="Name" class="form-label fw-semibold">
                                        <i class="bi bi-award me-2 text-primary-color"></i>
                                        Plan Name
                                    </label>

                                    <input asp-for="Name"
                                           class="form-control"
                                           readonly />

                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-item h-100">

                                    <label asp-for="DurationDays" class="form-label fw-semibold">
                                        <i class="bi bi-calendar-check me-2 text-primary-color"></i>
                                        Duration (Days)
                                    </label>

                                    <input asp-for="DurationDays"
                                           type="number"
                                           class="form-control" />

                                    <small class="text-muted">
                                        Example: 30 days = 1 month
                                    </small>

                                    <span asp-validation-for="DurationDays"
                                          class="text-danger d-block mt-1"></span>

                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-item h-100">

                                    <label asp-for="Price" class="form-label fw-semibold">
                                        <i class="bi bi-cash-stack me-2 text-primary-color"></i>
                                        Price (EGP)
                                    </label>

                                    <input asp-for="Price"
                                           type="number"
                                           class="form-control" />

                                    <span asp-validation-for="Price"
                                          class="text-danger d-block mt-1"></span>

                                </div>
                            </div>

                            <div class="col-12">
                                <div class="detail-item">

                                    <label asp-for="Description" class="form-label fw-semibold">
                                        <i class="bi bi-file-text me-2 text-primary-color"></i>
                                        Description
                                    </label>

                                    <textarea asp-for="Description"
                                              rows="5"
                                              class="form-control"></textarea>

                                    <span asp-validation-for="Description"
                                          class="text-danger d-block mt-1"></span>

                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="card-footer">

                        <div class="d-flex gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline flex-fill">
                                <i class="bi bi-arrow-left me-1"></i>
                                Back to Plans
                            </a>

                            <button id="submitBtn" type="submit" disabled
                                    class="btn get-started flex-fill">
                                <i class="bi bi-check-circle me-1"></i>
                                Update Plan
                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_DisabledSubmitBtnScript" />
}