@model PlanIndexViewModel
@{
	ViewData["Title"] = "Plans";
}

<div class="container pt-5">

	<nav class="breadcrumb-nav mb-3 pt-5" aria-label="Breadcrumb">
		<a asp-controller="Plans" asp-action="Index"><i class="bi bi-card-checklist me-1"></i>Plans</a>
		<span class="separator">/</span>
		<span class="text-muted">Plan Details</span>
	</nav>

	<div class="row justify-content-center">
		<div class="col-lg-7 col-md-9">
			<div class="card plan-detail-card border-0">
				<div class="card-header @(Model.IsActive ? "" : "inactive") text-white text-center">
					<i class="bi bi-award display-4 mb-3 d-block"></i>
					<h2 class="mb-2 fw-bold">@Model.Name</h2>
					@if (Model.IsActive)
					{
						<span class="badge bg-success fs-6">Active</span>
					}
					else
					{
						<span class="badge bg-secondary fs-6">Inactive</span>
					}
				</div>

				<div class="card-body">
					<div class="price-block text-center mb-4">
						<div class="display-3 fw-bold text-primary-color lh-1">@Model.Price.ToString("N0")</div>
						<small class="text-muted fs-5 fw-semibold">EGP</small>
					</div>

					<div class="plan-details d-flex flex-column gap-3">
						<div class="detail-item">
							<div class="d-flex align-items-center">
								<div class="icon-box me-3">
									<i class="bi bi-calendar-check text-primary-color fs-4"></i>
								</div>
								<div>
									<h6 class="mb-1 text-uppercase small fw-semibold">Duration</h6>
									<p class="mb-0 fw-bold fs-5">@Model.DurationDays days</p>
								</div>
							</div>
						</div>

						<div class="detail-item">
							<div class="d-flex align-items-start">
								<div class="icon-box me-3">
									<i class="bi bi-file-text text-primary-color fs-4"></i>
								</div>
								<div class="flex-grow-1">
									<h6 class="mb-2 text-uppercase small fw-semibold">Description</h6>
									<p class="mb-0">@Model.Description</p>
								</div>
							</div>
						</div>

						<div class="detail-item">
							<div class="d-flex align-items-center">
								<div class="icon-box me-3">
									@if (Model.IsActive)
									{
										<i class="bi bi-check-circle-fill text-success fs-4"></i>
									}
									else
									{
										<i class="bi bi-x-circle-fill text-danger fs-4"></i>
									}
								</div>
								<div>
									<h6 class="mb-1 text-uppercase small fw-semibold">Status</h6>
									<p class="mb-0">
										@if (Model.IsActive)
										{
											<span class="badge bg-success">Active</span>
										}
										else
										{
											<span class="badge bg-danger">Inactive</span>
										}
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card-footer">
					<div class="d-flex gap-2">
						<a asp-action="Index" class="btn btn-outline flex-fill">
							<i class="bi bi-arrow-left me-1"></i>Back to Plans
						</a>
						<a asp-controller="Plans" asp-action="Edit" asp-route-id="@Model.Id" class="btn get-started flex-fill">
							<i class="bi bi-pencil me-1"></i>Edit Plan
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

</div>